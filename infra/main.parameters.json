{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "appExists": {
      "value": "${SERVICE_APP_RESOURCE_EXISTS=false}"
    },
    "modelName": {
      "value": "${AZURE_VOICE_LIVE_MODEL=gpt-4o-mini}"
    },
    "telephonyProvider": {
      "value": "${TELEPHONY_PROVIDER=acs}"
    },
    "twilioAuthToken": {
      "value": "${TWILIO_AUTH_TOKEN}"
    },
    "infobipApiKey": {
      "value": "${INFOBIP_API_KEY}"
    },
    "infobipApiBaseUrl": {
      "value": "${INFOBIP_API_BASE_URL}"
    },
    "genesysApiKey": {
      "value": "${GENESYS_API_KEY}"
    },
    "sinchApplicationKey": {
      "value": "${SINCH_APPLICATION_KEY}"
    },
    "sinchApplicationSecret": {
      "value": "${SINCH_APPLICATION_SECRET}"
    },
    "bandwidthClientId": {
      "value": "${BANDWIDTH_CLIENT_ID}"
    },
    "bandwidthClientSecret": {
      "value": "${BANDWIDTH_CLIENT_SECRET}"
    },
    "bandwidthAccountId": {
      "value": "${BANDWIDTH_ACCOUNT_ID}"
    },
    "bandwidthApplicationId": {
      "value": "${BANDWIDTH_APPLICATION_ID}"
    },
    "debugMode": {
      "value": "${DEBUG_MODE=false}"
    },
    "existingResourceGroupName": {
      "value": "${EXISTING_RESOURCE_GROUP_NAME}"
    },
    "existingAcsName": {
      "value": "${EXISTING_ACS_NAME}"
    },
    "acsDataLocation": {
      "value": "${ACS_DATA_LOCATION=United States}"
    },
    "existingAiServicesName": {
      "value": "${EXISTING_AI_SERVICES_NAME}"
    },
    "existingAiServicesSubscriptionId": {
      "value": "${EXISTING_AI_SERVICES_SUBSCRIPTION_ID}"
    },
    "existingAiServicesResourceGroup": {
      "value": "${EXISTING_AI_SERVICES_RESOURCE_GROUP}"
    },
    "agentRoutingJsonBase64": {
      "value": "${AGENT_ROUTING_JSON_B64}"
    },
    "maxCallSeconds": {
      "value": "${MAX_CALL_SECONDS}"
    },
    "fallbackMessage": {
      "value": "${FALLBACK_MESSAGE}"
    },
    "ambientPreset": {
      "value": "${AMBIENT_PRESET}"
    },
    "acsCallbackJwtAudience": {
      "value": "${ACS_CALLBACK_JWT_AUDIENCE}"
    }
  }
}
