# .env

# --- Required: Core (needed for both azd up and local dev) ---
AZURE_VOICE_LIVE_API_KEY=<Find the key from your AI foundry resource>
AZURE_VOICE_LIVE_ENDPOINT=<Find the endpoint from your AI foundry resource>
VOICE_LIVE_MODEL=gpt-4o-mini

# --- Telephony Provider: set ONE to activate that provider ---
ACS_CONNECTION_STRING=<Find the connection string from your Communication Service resource>
# TWILIO_AUTH_TOKEN=<Twilio Auth Token for webhook signature validation>
# INFOBIP_API_KEY=<Infobip API Key>
# INFOBIP_API_BASE_URL=<e.g. https://xxxxx.api.infobip.com>
# GENESYS_API_KEY=<Genesys API Key for AudioHook authentication>

# --- Local dev only (not needed for azd up) ---
# ACS_DEV_TUNNEL=<Your devtunnel/ngrok URL for local ACS webhook testing>

# --- Required when ACS is configured (bridge_config.py) ---
# AGENT_ROUTING_JSON maps each E.164 phone number to the Foundry project/agent/pinned-version
# that answers calls to it. Example:
# AGENT_ROUTING_JSON={"+15555550100": {"project": "my-project", "agent": "my-agent", "version": "1"}}
# AGENT_ROUTING_JSON=<JSON object mapping E.164 numbers to {project, agent, version}>
# MEDIA_WS_TOKEN authenticates the ACS media-streaming websocket; must be at least 32 characters.
# MEDIA_WS_TOKEN=<32+ random chars>
# ACS_COGNITIVE_SERVICES_ENDPOINT=<Find the endpoint from your Cognitive Services resource>

# --- Optional: bridge behavior (bridge_config.py; spec names take precedence, D-003) ---
# VOICE_LIVE_ENDPOINT=<preferred over AZURE_VOICE_LIVE_ENDPOINT if both are set>
# VOICE_LIVE_API_VERSION=<pin a Voice Live API version; if unset, the SDK default (2026-07-15 in azure-ai-voicelive 1.3.0) is used>
# MAX_CALL_SECONDS=<preferred over MAX_CALL_DURATION; caps a call's length, default 600, max 3600>
# MAX_CALL_DURATION=<legacy name for MAX_CALL_SECONDS; kept for accelerator compatibility>
# MEDIA_CONNECT_TIMEOUT_SECONDS=<default 10>
# VOICE_LIVE_CONNECT_TIMEOUT_SECONDS=<default 8>
# MEDIA_LOST_GRACE_SECONDS=<default 5>
# FALLBACK_MESSAGE=<spoken when something goes wrong mid-call>
# GOODBYE_MESSAGE=<spoken when the call-length cap is reached>
# ACS_TTS_VOICE=<default en-US-JennyNeural>
# INTERIM_RESPONSE_JSON=<optional JSON object passed through to Voice Live for interim responses>
# ACS_CALLBACK_JWT_AUDIENCE turns on the check of the JWT that ACS attaches to each callback.
# Optional for local dev, but it MUST be set in any deployed environment (D-036): the signed
# callback URL stays valid for the whole call, so the JWT is the second factor. Verify the
# audience, issuer and JWKS values at deploy time (Q-005).
# ACS_CALLBACK_JWT_AUDIENCE=<expected audience on ACS callback JWTs (the ACS resource's immutable id)>

# --- Web debug client: OFF by default, local dev only — never in a deployed environment (D-007) ---
# ENABLE_WEB_CLIENT=true

# --- Optional ---
# Ambient Scenes: adds realistic background audio to simulate real-world call environments
# Options: none (default/disabled), office, call_center
# You can also add custom audio files - see README for details
AMBIENT_PRESET=none